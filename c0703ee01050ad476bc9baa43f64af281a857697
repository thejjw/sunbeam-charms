      },
      "lineNbr": 1357,
      "author": {
        "id": 35761
      },
      "writtenOn": "2026-11-19T21:11:17Z",
      "side": 1,
      "message": "This sends every backend’s raw CephX key through set_snap_data(), which logs the full settings dict at debug level. Could we log just the setting names?\n\nhttps://review.opendev.org/c/openstack/sunbeam-charms/+/1009340/5/charms/openstack-hypervisor/src/charm.py#906",
      "revId": "c0703ee01050ad476bc9baa43f64af281a857697",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "8b3de7cd_81414fd4",
        "filename": "charms/openstack-hypervisor/src/charm.py",
        "patchSetId": 5
      },
      "lineNbr": 1357,
