#!/usr/bin/bash

WRAPPER_LOG=/var/log/ovn/cluster_join_wrapper.log

function log_msg()
{
    msg=$1
    echo "$(date): $msg" >> $WRAPPER_LOG
}

{% if ovs_db.is_unit_cluster_member %}
if ls -l /var/lib/ovn/{.ovn,ovn}nb* &> /dev/null; then
    # ovsdb-server refuses to start from a DB that recorded a cluster
    # leave; such files can only be replaced by joining again.
    if ovsdb-tool show-log /var/lib/ovn/ovnnb_db.db 2> /dev/null | grep -q 'note: "left"'; then
        log_msg "DB files record that this server left the cluster, removing them"
        rm -f /var/lib/ovn/{.ovn,ovn}nb*
    else
        log_msg "Existing DB files found, skipping join"
        exit 0
    fi
fi
{% else %}
if ls -l /var/lib/ovn/{.ovn,ovn}nb* &> /dev/null; then
    log_msg "Replacement unit, removing stale DB files"
    rm -f /var/lib/ovn/{.ovn,ovn}nb*
fi
{% endif %}
log_msg "No existing DB files present"
ADDRESSES="{{ peers.db_nb_cluster_connection_strs|join(' ') }}"
log_msg "Running join-cluster cmd: ovsdb-tool join-cluster /var/lib/ovn/ovnnb_db.db OVN_Northbound $ADDRESSES"
ovsdb-tool join-cluster /var/lib/ovn/ovnnb_db.db OVN_Northbound $ADDRESSES &> $WRAPPER_LOG
