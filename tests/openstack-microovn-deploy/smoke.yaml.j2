---
applications:
  tls-operator:
    offers:
      certificates:
        endpoints:
          - certificates
  rabbitmq:
    offers:
      amqp:
        endpoints:
          - amqp
  keystone:
    offers:
      identity-service:
        endpoints:
          - identity-service
      identity-credentials:
        endpoints:
          - identity-credentials
      send-ca-cert:
        endpoints:
          - send-ca-cert
  nova:
    offers:
      nova-service:
        endpoints:
          - nova-service
  traefik-rgw:
    offers:
      traefik-route-rgw:
        endpoints:
          - traefik-route
  manila-router:
    offers:
      manila-database:
        endpoints:
          - database
