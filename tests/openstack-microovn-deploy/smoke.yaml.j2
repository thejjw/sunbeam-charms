bundle: kubernetes

applications:
  traefik:
    charm: ch:traefik-k8s
    channel: latest/candidate
    base: ubuntu@26.04
    scale: 1
    trust: true
    options:
      kubernetes-service-annotations: metallb.universe.tf/address-pool=public
  traefik-rgw:
    charm: ch:traefik-k8s
    channel: latest/candidate
    base: ubuntu@26.04
    scale: 1
    trust: true
    options:
      kubernetes-service-annotations: metallb.universe.tf/address-pool=public
  mysql:
    charm: ch:mysql-k8s
    channel: 8.0/stable
    base: ubuntu@22.04
    scale: 1
    trust: true
    options:
      profile-limit-memory: 6202
      experimental-max-connections: 466
  ldap-server:
    charm: ch:ldap-test-fixture-k8s
    channel: edge
    base: ubuntu@22.04
    scale: 1
  tls-operator:
    charm: self-signed-certificates
    channel: 1/beta
    base: ubuntu@24.04
    scale: 1
    options:
      ca-common-name: internal-ca
  rabbitmq:
    charm: ch:rabbitmq-k8s
    channel: 4.0/edge
    base: ubuntu@24.04
    scale: 1
    trust: true
    options:
      minimum-replicas: 1
  keystone:
    {% if keystone_k8s is defined and keystone_k8s is sameas true -%}
    charm: ../../../keystone-k8s.charm
    {% else -%}
    charm: ch:keystone-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    storage:
      fernet-keys: 5M
      credential-keys: 5M
    resources:
      keystone-image: ghcr.io/canonical/keystone:2026.2-26.04_edge
  glance:
    {% if glance_k8s is defined and glance_k8s is sameas true -%}
    charm: ../../../glance-k8s.charm
    {% else -%}
    charm: ch:glance-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    storage:
      local-repository: 10G
    resources:
      glance-api-image: ghcr.io/canonical/glance-api:2026.2-26.04_edge
  nova:
    {% if nova_k8s is defined and nova_k8s is sameas true -%}
    charm: ../../../nova-k8s.charm
    {% else -%}
    charm: ch:nova-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      nova-api-image: ghcr.io/canonical/nova-consolidated:2026.2-26.04_edge
      nova-scheduler-image: ghcr.io/canonical/nova-consolidated:2026.2-26.04_edge
      nova-conductor-image: ghcr.io/canonical/nova-consolidated:2026.2-26.04_edge
      nova-spiceproxy-image: ghcr.io/canonical/nova-consolidated:2026.2-26.04_edge
  placement:
    {% if placement_k8s is defined and placement_k8s is sameas true -%}
    charm: ../../../placement-k8s.charm
    {% else -%}
    charm: ch:placement-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      placement-api-image: ghcr.io/canonical/placement-api:2026.2-26.04_edge
  neutron:
    {% if neutron_k8s is defined and neutron_k8s is sameas true -%}
    charm: ../../../neutron-k8s.charm
    {% else -%}
    charm: ch:neutron-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    options:
      debug: true
    resources:
      neutron-server-image: ghcr.io/canonical/neutron-consolidated:2026.2-26.04_edge
  neutron-baremetal-config:
    {% if neutron_baremetal_switch_config_k8s is defined and neutron_baremetal_switch_config_k8s is sameas true -%}
    charm: ../../../neutron-baremetal-switch-config-k8s.charm
    {% else -%}
    charm: ch:neutron-baremetal-switch-config-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    options:
      debug: true
  neutron-generic-config:
    {% if neutron_generic_switch_config_k8s is defined and neutron_generic_switch_config_k8s is sameas true -%}
    charm: ../../../neutron-generic-switch-config-k8s.charm
    {% else -%}
    charm: ch:neutron-generic-switch-config-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    options:
      debug: true
  horizon:
    {% if horizon_k8s is defined and horizon_k8s is sameas true -%}
    charm: ../../../horizon-k8s.charm
    {% else -%}
    charm: ch:horizon-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    resources:
      horizon-image: ghcr.io/canonical/horizon:2026.2-26.04_edge
  # Bare metal feature
  ironic:
    {% if ironic_k8s is defined and ironic_k8s is sameas true -%}
    charm: ../../../ironic-k8s.charm
    {% else -%}
    charm: ch:ironic-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      ironic-api-image: ghcr.io/canonical/ironic-consolidated:2026.2-26.04_edge
      ironic-novncproxy-image: ghcr.io/canonical/ironic-consolidated:2026.2-26.04_edge
  ironic-conductor:
    {% if ironic_conductor_k8s is defined and ironic_conductor_k8s is sameas true -%}
    charm: ../../../ironic-conductor-k8s.charm
    {% else -%}
    charm: ch:ironic-conductor-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      ironic-conductor-image: ghcr.io/canonical/ironic-conductor:2026.2-26.04_edge
  nova-ironic:
    {% if nova_ironic_k8s is defined and nova_ironic_k8s is sameas true -%}
    charm: ../../../nova-ironic-k8s.charm
    {% else -%}
    charm: ch:nova-ironic-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      nova-ironic-image: ghcr.io/canonical/nova-ironic:2026.2-26.04_edge
  # Shared filesystems feature
  manila-router:
    charm: ch:mysql-router-k8s
    channel: 8.0/edge
    base: ubuntu@22.04
    scale: 1
    trust: true
    options:
      expose-external: loadbalancer
  manila:
    {% if manila_k8s is defined and manila_k8s is sameas true -%}
    charm: ../../../manila-k8s.charm
    {% else -%}
    charm: ch:manila-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: false
    resources:
      manila-api-image: ghcr.io/canonical/manila-consolidated:2026.2-26.04_edge
      manila-scheduler-image: ghcr.io/canonical/manila-consolidated:2026.2-26.04_edge
  manila-cephfs:
    {% if manila_cephfs_k8s is defined and manila_cephfs_k8s is sameas true -%}
    charm: ../../../manila-cephfs-k8s.charm
    {% else -%}
    charm: ch:manila-cephfs-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: false
    resources:
      manila-share-image: ghcr.io/canonical/manila-share:2026.2-26.04_edge
  # Telemetry feature
  gnocchi:
    {% if gnocchi_k8s is defined and gnocchi_k8s is sameas true -%}
    charm: ../../../gnocchi-k8s.charm
    {% else -%}
    charm: ch:gnocchi-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      gnocchi-api-image: ghcr.io/canonical/gnocchi-consolidated:2026.2-26.04_edge
      gnocchi-metricd-image: ghcr.io/canonical/gnocchi-consolidated:2026.2-26.04_edge
  ceilometer:
    {% if ceilometer_k8s is defined and ceilometer_k8s is sameas true -%}
    charm: ../../../ceilometer-k8s.charm
    {% else -%}
    charm: ch:ceilometer-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      ceilometer-central-image: ghcr.io/canonical/ceilometer-consolidated:2026.2-26.04_edge
      ceilometer-notification-image: ghcr.io/canonical/ceilometer-consolidated:2026.2-26.04_edge
  openstack-exporter:
    {% if openstack_exporter_k8s is defined and openstack_exporter_k8s is sameas true -%}
    charm: ../../../openstack-exporter-k8s.charm
    {% else -%}
    charm: ch:openstack-exporter-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    resources:
      openstack-exporter-image: ghcr.io/canonical/openstack-exporter:1.7.0-3be9ddb-bare_edge
  watcher:
    {% if watcher_k8s is defined and watcher_k8s is sameas true -%}
    charm: ../../../watcher-k8s.charm
    {% else -%}
    charm: ch:watcher-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      watcher-image: ghcr.io/canonical/watcher-consolidated:2026.2-26.04_edge
  keystone-ldap:
    {% if keystone_ldap_k8s is defined and keystone_ldap_k8s is sameas true -%}
    charm: ../../../keystone-ldap-k8s.charm
    {% else -%}
    charm: ch:keystone-ldap-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
  # Rating feature
  cloudkitty:
    {% if cloudkitty_k8s is defined and cloudkitty_k8s is sameas true -%}
    charm: ../../../cloudkitty-k8s.charm
    {% else -%}
    charm: ch:cloudkitty-k8s
    channel: 2026.2/edge
    {% endif -%}
    base: ubuntu@26.04
    scale: 1
    trust: true
    resources:
      cloudkitty-image: ghcr.io/canonical/cloudkitty-consolidated:2026.2-26.04_edge

